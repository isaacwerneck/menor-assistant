[Unit]
Description=Executar missões aprovadas do Menor com subagentes locais
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/menor-assistant
EnvironmentFile=-%h/.config/menor/environment
ExecStart=%h/menor-assistant/.venv/bin/python -m src.agent.mission_worker
TimeoutStartSec=150min
NoNewPrivileges=true
UMask=0077

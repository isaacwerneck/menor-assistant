[Unit]
Description=Menor API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/menor-assistant
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/menor/environment
ExecStart=%h/menor-assistant/.venv/bin/python -m uvicorn src.api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target

#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "Não consegui controlar o Menor. Consulte systemctl --user status menor-api.service." >&2' ERR

timers=()
workers=()
for name in menor-deploy menor-missions menor-review; do
    if systemctl --user cat "$name.timer" >/dev/null 2>&1; then
        timers+=("$name.timer")
        workers+=("$name.service")
    fi
done

case "${1:-status}" in
    start|iniciar)
        systemctl --user start menor-api.service "${timers[@]}"
        echo "Menor iniciado."
        ;;
    stop|parar)
        if (( ${#timers[@]} )); then
            systemctl --user stop "${timers[@]}" "${workers[@]}"
        fi
        systemctl --user stop menor-api.service
        echo "Menor parado; os timers não vão religar a API."
        ;;
    restart|reiniciar)
        systemctl --user restart menor-api.service
        if (( ${#timers[@]} )); then
            systemctl --user start "${timers[@]}"
        fi
        echo "API do Menor reiniciada."
        ;;
    status)
        systemctl --user --no-pager status menor-api.service "${timers[@]}"
        ;;
    monitor|monitorar)
        shift
        # readlink -f resolve o symlink de ~/.local/bin/menor.
        root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        cd "$root"
        if [[ -x "$root/.venv/bin/python" ]]; then
            exec "$root/.venv/bin/python" -m ops.monitor "$@"
        fi
        exec python3 -m ops.monitor "$@"
        ;;
    benchmark|latencia)
        shift
        root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        cd "$root"
        if [[ -x "$root/.venv/bin/python" ]]; then
            exec "$root/.venv/bin/python" -m ops.model_latency "$@"
        fi
        exec python3 -m ops.model_latency "$@"
        ;;
    ciclo|cycle)
        shift
        root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        cd "$root"
        if [[ -x "$root/.venv/bin/python" ]]; then
            exec "$root/.venv/bin/python" -c "from src.agent.study import run_autonomous_cycle; res = run_autonomous_cycle(); print(res)" "$@"
        fi
        exec python3 -c "from src.agent.study import run_autonomous_cycle; res = run_autonomous_cycle(); print(res)" "$@"
        ;;
    relatorio|report)
        shift
        root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        cd "$root"
        if [[ -x "$root/.venv/bin/python" ]]; then
            exec "$root/.venv/bin/python" -c "from src.tools.core import get_study_report; r = get_study_report(); print(r.get('report_markdown', r.get('message')))" "$@"
        fi
        exec python3 -c "from src.tools.core import get_study_report; r = get_study_report(); print(r.get('report_markdown', r.get('message')))" "$@"
        ;;
    estudar|study)
        shift
        root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        cd "$root"
        if [[ -x "$root/.venv/bin/python" ]]; then
            exec "$root/.venv/bin/python" -c "from src.agent.study import StudyWorker; w = StudyWorker(); res = w.study_cycle(); print(res)" "$@"
        fi
        exec python3 -c "from src.agent.study import StudyWorker; w = StudyWorker(); res = w.study_cycle(); print(res)" "$@"
        ;;
    diagnosticar|diagnostic|eval)
        shift
        root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        cd "$root"
        if [[ -x "$root/.venv/bin/python" ]]; then
            exec "$root/.venv/bin/python" -c "from src.agent.study import DiagnosticEngine; d = DiagnosticEngine(); res = d.run_self_eval(); print(res)" "$@"
        fi
        exec python3 -c "from src.agent.study import DiagnosticEngine; d = DiagnosticEngine(); res = d.run_self_eval(); print(res)" "$@"
        ;;
    refletir|reflect)
        shift
        root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        cd "$root"
        if [[ -x "$root/.venv/bin/python" ]]; then
            exec "$root/.venv/bin/python" -m src.agent.reflection "$@"
        fi
        exec python3 -m src.agent.reflection "$@"
        ;;
    *)
        echo "Uso: menor {start|stop|restart|status|monitor|benchmark|refletir|estudar|diagnosticar|ciclo|relatorio}" >&2
        exit 2
        ;;
esac
